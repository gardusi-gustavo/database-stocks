{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Database dataset envelope",
  "type": "object",
  "required": [
    "schema",
    "domain",
    "date",
    "generated_at",
    "source"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "domain": {
      "enum": [
        "lottery",
        "news",
        "playlists",
        "stocks"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "generated_at": {
      "type": "string"
    },
    "source": {
      "type": "object"
    },
    "items": {
      "type": "array"
    },
    "collections": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "required": [
        "items"
      ]
    },
    {
      "required": [
        "collections"
      ]
    }
  ]
}
